{
  "name": "haya-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src index.html package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
